# Copy to deploy/.env and replace every placeholder before starting the stack.
# Keep deploy/.env out of version control; it holds production secrets.

# Container image. Pin an exact release instead of "latest".
AGENTLOOP_IMAGE=ghcr.io/dipeshbabu/agentloop:0.2.9

# Public hostnames. Point both DNS records (A/AAAA) at this host first.
AGENTLOOP_API_DOMAIN=agentloop-api.example.com
AGENTLOOP_DASHBOARD_DOMAIN=agentloop.example.com

# Admin secret for creating project API keys. Generate with: openssl rand -hex 32
AGENTLOOP_ADMIN_API_KEY=replace-with-a-long-random-admin-secret

# Dashboard login. Create the bcrypt hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes so Compose does not expand the $ characters in the hash.
AGENTLOOP_DASHBOARD_USER=admin
AGENTLOOP_DASHBOARD_PASSWORD_HASH='replace-with-a-bcrypt-hash'

# Database. Mounted as a Compose secret; never embedded in a URL.
POSTGRES_DB=agentloop
POSTGRES_USER=agentloop
POSTGRES_PASSWORD=replace-with-a-long-random-db-password

# Delete traces stored more than this many days ago (checked daily).
# Leave empty to keep traces until they are deleted by hand.
AGENTLOOP_RETENTION_DAYS=

# Largest trace upload the proxy accepts.
AGENTLOOP_MAX_UPLOAD=16MB
# The API's own limit in bytes (default 16 MiB). Raise both together.
AGENTLOOP_MAX_REQUEST_BYTES=16777216
