# Copy to config.env and adjust. Non-secret settings shared by every AgentLoop pod.

# Public origin of the dashboard, allowed to call the API from browsers.
AGENTLOOP_CORS_ORIGINS=https://agentloop.example.com
# Delete traces stored more than this many days ago (daily CronJob). Empty keeps them.
AGENTLOOP_RETENTION_DAYS=90
# The API's request body limit in bytes. Match your ingress body-size limit.
AGENTLOOP_MAX_REQUEST_BYTES=16777216

# Database connection. "postgres" is the evaluation StatefulSet in this directory;
# point these at your managed Postgres for production.
PGHOST=agentloop-postgres
PGPORT=5432
PGDATABASE=agentloop
PGUSER=agentloop
