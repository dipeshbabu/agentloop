# Copy to secrets.env (never commit it) and replace every value.
# Generate secrets with: openssl rand -hex 32

# Creates and revokes project API keys. Keep it out of clients.
AGENTLOOP_ADMIN_API_KEY=replace-with-a-long-random-admin-secret
# Database password, used by AgentLoop and by the evaluation Postgres.
PGPASSWORD=replace-with-a-long-random-db-password
