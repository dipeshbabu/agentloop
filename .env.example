# Copy to .env for docker compose or your hosting platform.

AGENTLOOP_STORE_BACKEND=postgres
AGENTLOOP_REQUIRE_API_KEY=true
AGENTLOOP_ADMIN_API_KEY=replace-with-a-long-random-admin-secret
AGENTLOOP_CORS_ORIGINS=http://localhost:8501
AGENTLOOP_API_URL=http://localhost:8000

POSTGRES_DB=agentloop
POSTGRES_USER=agentloop
# Docker Compose mounts this value as a secret instead of embedding it in a URL.
# URI-reserved punctuation such as / ? # % @ and : is supported.
POSTGRES_PASSWORD=replace-with-a-long-random-db-password

# Non-Compose deployments may use a complete URL instead. Percent-encode reserved
# username/password characters when using this form; it takes precedence over PG* variables.
# AGENTLOOP_DATABASE_URL=postgresql://agentloop:encoded-password@db:5432/agentloop
